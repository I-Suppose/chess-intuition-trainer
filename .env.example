# Local Python process connects through 127.0.0.1; Docker containers use host.docker.internal.
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/chess_trainer?charset=utf8mb4
DATABASE_URL_DOCKER=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@host.docker.internal:3306/chess_trainer?charset=utf8mb4
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRY_DAYS=7
REDIS_URL=redis://localhost:6379/0
STOCKFISH_PATH=
STOCKFISH_THREADS=2
STOCKFISH_HASH_MB=256
STOCKFISH_MULTIPV=3
STOCKFISH_DEPTH=16
STOCKFISH_TIME_LIMIT=2.0
STOCKFISH_SCAN_TIME_LIMIT=0.25
INITIAL_GAME_IMPORT_LIMIT=100
VITE_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
